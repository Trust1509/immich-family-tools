# Copy to .env and adjust before starting

# Required shared login token (no user management). Use a long random value.
IMMICH_FAMILY_TOOLS_SECRET=replace-with-a-long-random-token

# Session lifetime and cookie mode. Keep COOKIE_SECURE=false for local HTTP.
IMMICH_FAMILY_TOOLS_SESSION_TTL_HOURS=168
IMMICH_FAMILY_TOOLS_COOKIE_SECURE=false

# Timezone for the container — required for auto-sync to fire at the correct local time.
# Without this, the container runs in UTC. Examples:
#   Europe/Vienna, Europe/Berlin, Europe/London, America/New_York, Asia/Tokyo
TZ=Europe/Vienna
